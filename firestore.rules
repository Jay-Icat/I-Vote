rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Competitions: Anyone can read.
    // For this prototype, we'll allow anyone to write so the admin panel can sync.
    match /competitions/{competitionId} {
      allow read, write: if true;
    }
    
    // Votes: Anyone can read. Users can write their own votes.
    match /votes/{voteId} {
      allow read: if true;
      // Allow write if authenticated. Or `if true` for demo purposes.
      allow write: if true;
    }
    
  }
}
